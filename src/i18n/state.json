    },
    "9404b02c8383368836de126e3bd98f189ff6fcfb5dc1b2a1313a8da0dfcff891": {
      "text": "Before deciding what your brand will look like, we need to understand what it has to say.",
      "engine": "google-basic-v2:nmt:pt-en:text:ast-v1",
      "date": "2026-10-27T17:42:47.067Z"
    },
    "be40435aa6feaa3fa27e571cdad346d38d8b7e04f92f08212754ee980fa0e02b": {
      "text": "Before thinking about colors, fonts, or references, I like to understand the problem. Who is the brand? Who does it want to communicate with? What needs to change? What already works?",
      "engine": "google-basic-v2:nmt:pt-en:text:ast-v1",
      "date": "2026-10-27T17:42:47.067Z"
    },
    "cfd892b8fd66021fd61f3ce6e67f094f97d19050a23203134cadeba3f04cac25": {
      "text": "Application of the Amazonita art direction in the opening of the digital experience.",
      "engine": "google-basic-v2:nmt:pt-en:text:ast-v1",
      "date": "2026-10-27T17:42:47.067Z"
    },
    "6db021e5d7f53400925a05a857b7f587dd4a9afc4267b5b55f9c2a286c612e0d": {
      "text": "Applications of the brand presented in the Rooftop manual.",
      "engine": "google-basic-v2:nmt:pt-en:text:ast-v1",
