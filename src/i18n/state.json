    "120c8ce72f1cb6192d69e3ba8667e2c9be4b060dd84110e02946407ff4efced4": {
      "text": "404 / An open path",
      "engine": "google-basic-v2:nmt:pt-en:text:ast-v1",
      "date": "2026-10-27T17:42:47.067Z"
    },
    "30acabc9a4491953ebdfc51b23247c09442d7c7ef4471ef179cdfe01c73cc85e": {
      "text": "Amazonita has a texture and color that immediately draw attention. My job was to create a presentation for Granistone where the rock remained central, from the editorial design to the digital experience.",
      "engine": "google-basic-v2:nmt:pt-en:text:ast-v1",
      "date": "2026-10-27T17:42:47.067Z"
    },
    "5ad7831a897ced1a8dd496e155d788cd9f35e91aa7372de61adf37fb0561ea19": {
      "text": "The signature uses Tenor Sans and the supporting text uses Nexa, as per the manual. Warm tones—from terracotta to orange—accompany dark and light neutrals. The symbol brings together ascending strokes in a compact composition.",
      "engine": "google-basic-v2:nmt:pt-en:text:ast-v1",
      "date": "2026-10-27T17:42:47.067Z"
    },
    "d266f24d23d026685344db9113fe3e7a0d1cf68a0111eb3f3c250b1e33ce2857": {
      "text": "The signature style, color palette, and application guidelines create a consistent visual presence, showcased in examples of brand usage.",
      "engine": "google-basic-v2:nmt:pt-en:text:ast-v1",
      "date": "2026-10-27T17:42:47.067Z"
    },
    "46f4adbf75e9bb68cac20bec50f1f6536865c0c9c66df7a78735dc666b5f521d": {
      "text": "Confirmation is taking some time. Your data is still here. You can wait, try again, or use direct email.",
      "engine": "google-basic-v2:nmt:pt-en:text:ast-v1",
      "date": "2026-10-27T17:42:47.067Z"
    },
    "9a50f725d9cd20d55a112a4d7fad1f1bc8af05d33036b661cfc9426a415b86d7": {
      "text": "The force of nature. A fitting expression.",
      "engine": "google-basic-v2:nmt:pt-en:text:ast-v1",
      "date": "2026-10-27T17:42:47.067Z"
    },
    "24a4ff194e8aeb413c6378f1b06153b89c6c6ef4afa6f0f63afc1d3da92236d0": {
      "text": "Amanda Araújo's brand identity seeks to convey trust and approachability in a financial consulting firm. This manual outlines the choices that underpin this image.",
      "engine": "google-basic-v2:nmt:pt-en:text:ast-v1",
      "date": "2026-10-27T17:42:47.067Z"
    },
    "f3be5f9ce2044427101231bf293cb24d178459f5eb85ecdcfa9424670ddecb5f": {
      "text": "The identity brings together the manual, variations of the signature, and an editorial presentation that organizes the projects without competing for attention with the architecture.",
      "engine": "google-basic-v2:nmt:pt-en:text:ast-v1",
      "date": "2026-10-27T17:42:47.067Z"
    },
    "606b24de1138b4eef4ab73016745b3727408475dc2b0a2b21729f4478996eb86": {
      "text": "Identity takes shape in combined applications. We review how it works and prepare the expected deliverables.",
      "engine": "google-basic-v2:nmt:pt-en:text:ast-v1",
      "date": "2026-10-27T17:42:47.067Z"
    },
    "c41d5d6dfc5e3597f81a511deddc9990690f3a012ae1767abedc79847305d4de": {
      "text": "The language gained expression in motion graphics, editorial pieces, landing pages, and interface guidelines. In each format, Amazonita continues to be the protagonist.",
      "engine": "google-basic-v2:nmt:pt-en:text:ast-v1",
      "date": "2026-10-27T17:42:47.067Z"
    },
    "3a0d5b602a7074a944a83ff57ff8169ffdf07976e907c526c573d20f85bcb97d": {
      "text": "Raw materials as the main focus.",
      "engine": "google-basic-v2:nmt:pt-en:text:ast-v1",
      "date": "2026-10-27T17:42:47.067Z"
    },
    "53f4d9302b4eda264976138c074a832bade08bc0b31252f35d51091ba43228d7": {
      "text": "The neutral palette creates space for the raw material. Typographic hierarchy, buttons, and interface states establish continuity between touchpoints.",
      "engine": "google-basic-v2:nmt:pt-en:text:ast-v1",
      "date": "2026-10-27T17:42:47.067Z"
    },
    "7865477464b50056716cb7a13676af1839f456961dbd139f07c6d4964357b7e6": {
      "text": "The translation of this page is not yet available.",
      "engine": "google-basic-v2:nmt:pt-en:text:ast-v1",
      "date": "2026-10-27T17:42:47.067Z"
