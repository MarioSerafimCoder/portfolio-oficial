    "d0ca32772b703f027840c6c862f8eb79f2b277d9b4ab6fb1d81f2138848bdb47": {
      "text": "Amazonita: blue-green rock in a composition of art direction and digital design.",
      "engine": "google-basic-v2:nmt:pt-en:text:ast-v1",
      "date": "2026-10-27T17:42:47.067Z"
    },
    "827d1a2332b3596e83e22d2fed72000e99323169592bf2b8fc916ac11400b6d0": {
      "text": "Year of the material",
      "engine": "google-basic-v2:nmt:pt-en:text:ast-v1",
      "date": "2026-10-27T17:42:47.067Z"
    },
    "6b884705dbfdff6a746dcbd9bd9068a18bee6bd09d0e65e89c64319e542c6cc9": {
      "text": "Before we begin.",
      "engine": "google-basic-v2:nmt:pt-en:text:ast-v1",
